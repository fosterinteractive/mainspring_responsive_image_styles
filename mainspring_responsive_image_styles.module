<?php

/**
 * @file
 * This is the mainspring_responsive_image_styles module.
 *
 * It adds the paragraphs layout configuration to paragraphs as variables, and
 * prepends "auto" to the sizes attribute of lazy-loaded responsive images.
 */

use Drupal\Core\Site\Settings;
use Drupal\Core\Template\Attribute;
use Drupal\Core\Template\AttributeValueBase;

/**
 * Implements hook_preprocess_paragraph().
 */
function mainspring_responsive_image_styles_preprocess_paragraph(array &$variables) {
  $paragraph = $variables['paragraph'];

  // PARAGRAPH LAYOUT / REGION VARIABLES.
  // Determine the layout and region a paragraph is in so we can set a specific
  // reponsive image style based on the layout. e.g. if a image is in a 4 col.
  $behavior_settings = $paragraph->getAllBehaviorSettings();
  $layout_paragraphs_settings = $behavior_settings['layout_paragraphs'] ?? [];
  if (!empty($layout_paragraphs_settings['parent_uuid']) && $parent = $paragraph->getParentEntity()) {
    $parent_field = $paragraph->get('parent_field_name');
    $field_name = $parent_field->first()->getString();
    $item_list = $parent->get($field_name);
    /** @var \Drupal\Core\Field\EntityReferenceFieldItemList $item_list */
    $sibling_paragraphs = $item_list->referencedEntities();
    if (count($sibling_paragraphs)) {
      $uuid_map = [];
      foreach ($sibling_paragraphs as $delta => $item) {
        $uuid_map[$item->uuid()] = $delta;
      }

      $parent_delta = $uuid_map[$layout_paragraphs_settings['parent_uuid']] ?? NULL;
      if (isset($parent_delta)) {
        $field = $paragraph->getParentEntity()->get($field_name)->get($parent_delta);
        // Skip the layout variables if the section paragraph can't be loaded
        // (e.g. a missing revision) instead of a fatal error on NULL.
        $target = !empty($field) ? $field->get('entity')->getTarget() : NULL;
        if ($target) {
          $layout_paragraph = $target->getValue();
          $layout_settings = $layout_paragraph->getAllBehaviorSettings();

          $variables['paragraph_layout'] = $layout_settings['layout_paragraphs']['layout'] ?? NULL;
          $variables['paragraph_columns'] = isset($layout_settings['layout_paragraphs']['config']['classes']['width']) ? $layout_settings['layout_paragraphs']['config']['classes']['width'] : ($layout_settings['layout_paragraphs']['config']['classes']['section_layout'] ?? NULL);
          $variables['paragraph_region'] = $layout_paragraphs_settings['region'] ?? NULL;
        }
      }
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for responsive_image.
 *
 * Prepends "auto" to the sizes attribute of lazy-loaded responsive images so
 * browsers that support sizes="auto" pick a srcset candidate from the image's
 * rendered width. Other browsers ignore "auto" and use the rest of the list.
 * Per the HTML spec "auto" only applies to loading="lazy" images, so eager
 * images are left untouched.
 *
 * Opt out per site with $settings['mainspring_sizes_auto'] = FALSE;
 *
 * @see https://html.spec.whatwg.org/multipage/images.html#sizes-attributes
 */
function mainspring_responsive_image_styles_preprocess_responsive_image(array &$variables): void {
  if (!Settings::get('mainspring_sizes_auto', TRUE)) {
    return;
  }

  // Mirror template_preprocess_image(): an image with dimensions and no
  // loading attribute is rendered with loading="lazy".
  $img = $variables['img_element'] ?? [];
  $loading = $img['#attributes']['loading'] ?? NULL;
  if ($loading === NULL) {
    $loading = isset($img['#width'], $img['#height']) ? 'lazy' : '';
  }
  if (strtolower(trim((string) $loading)) !== 'lazy') {
    return;
  }

  // <img srcset sizes> (single image tag, and the <picture> fallback img).
  if (isset($img['#attributes']['sizes'])) {
    $sizes = _mainspring_responsive_image_styles_sizes_auto($img['#attributes']['sizes']);
    if ($sizes !== NULL) {
      $variables['img_element']['#attributes']['sizes'] = $sizes;
    }
  }

  // <picture><source sizes>. Runs before webp (module weight 0, alphabetical),
  // so the webp <source> clones inherit the change.
  foreach ($variables['sources'] ?? [] as $source) {
    if ($source instanceof Attribute && $source->hasAttribute('sizes')) {
      $sizes = _mainspring_responsive_image_styles_sizes_auto($source['sizes']);
      if ($sizes !== NULL) {
        $source->setAttribute('sizes', $sizes);
      }
    }
  }
}

/**
 * Prepends "auto, " to a sizes value unless it already starts with "auto".
 *
 * @param mixed $sizes
 *   The sizes value: a string or an AttributeValueBase object.
 *
 * @return string|null
 *   The raw (unescaped) sizes value starting with "auto", or NULL if empty.
 */
function _mainspring_responsive_image_styles_sizes_auto($sizes): ?string {
  // Use the raw value: casting an AttributeString to string HTML-escapes it,
  // which would be escaped again on output (e.g. "(width >= 768px)").
  if ($sizes instanceof AttributeValueBase) {
    $sizes = $sizes->value();
  }
  if (!is_string($sizes) || trim($sizes) === '') {
    return NULL;
  }
  return preg_match('/^\s*auto\s*(,|$)/i', $sizes) ? $sizes : 'auto, ' . $sizes;
}
